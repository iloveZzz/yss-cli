--- /dev/null
+++ b/src/browser/CspStyle.ts
@@ -0,0 +1,12 @@
+/**
+ * YSS supplies this nonce on the local desktop document through the Tauri asset CSP.
+ */
+export function createTerminalStyle(document: Document): HTMLStyleElement {
+  const style = document.createElement('style');
+  const nonce = document.querySelector<HTMLStyleElement>('#terminal-style-nonce')?.nonce;
+  if (!nonce) {
+    throw new Error('终端页面缺少样式授权');
+  }
+  style.nonce = nonce;
+  return style;
+}
